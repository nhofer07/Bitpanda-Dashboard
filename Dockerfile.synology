# Frontend and tests are built/run on the Mac by package-release.py --synology.
FROM node:22-alpine
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0 \
    DASHBOARD_DATA_DIR=/data
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY backend/*.js ./
RUN node --check server.js && mkdir -p /data
COPY synology-frontend/ /app/frontend/dist/
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD wget -qO- http://127.0.0.1:3001/health >/dev/null || exit 1
CMD ["node", "server.js"]
