# Diese Datei auf der Synology als .env speichern und das Passwort ersetzen.
CONTAINER_NAME=bitpanda-dashboard-nico
DASHBOARD_PORT=8085
DASHBOARD_DATA_PATH=./data-nico

# Der ChatGPT-Anmeldeport wird aus dem Webport gebildet: 8085 → 18085.
# Für diese Compose-Konfiguration einen Webport zwischen 1024 und 9999 verwenden.
