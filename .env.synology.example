# Diese Datei auf der Synology als .env speichern und das Passwort ersetzen.
CONTAINER_NAME=bitpanda-dashboard-nico
DASHBOARD_PORT=8085
DASHBOARD_DATA_PATH=./data-nico

# Optional: eigener Callback-Port; Standard ist 1 + Webport (8085 → 18085).
# Bei einem Webport über 9999 hier einen freien Port bis 65535 festlegen.
# CHATGPT_CALLBACK_PORT=18085
